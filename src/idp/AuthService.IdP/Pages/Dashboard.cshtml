@page
@model AuthService.IdP.Pages.DashboardModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Dashboard — Auth Service</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            color: #e0e0e0;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding: 1rem 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

        .brand-logo svg {
            width: 18px;
            height: 18px;
            fill: white;
        }

        .brand-name {
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.02em;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-details {
            text-align: right;
        }

        .user-name {
            font-size: 0.875rem;
            font-weight: 600;
            color: #ffffff;
        }

        .user-email {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.5);
        }

        .logout-btn {
            padding: 0.5rem 1rem;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 8px;
            color: #fca5a5;
            font-size: 0.8125rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.4);
            color: #ef4444;
            transform: translateY(-1px);
        }

        .app-logout-btn {
            padding: 0.5rem 1rem;
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 8px;
            color: #93c5fd;
            font-size: 0.8125rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
            margin-right: 0.5rem;
        }

        .app-logout-btn:hover {
            background: rgba(59, 130, 246, 0.2);
            border-color: rgba(59, 130, 246, 0.4);
            color: #3b82f6;
            transform: translateY(-1px);
        }

        /* Main Container */
        .container {
            max-width: 1000px;
            margin: 3.5rem auto;
            padding: 0 2rem;
            flex-grow: 1;
            width: 100%;
        }

        .dashboard-header {
            margin-bottom: 2.5rem;
            animation: fadeInDown 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .dashboard-header h1 {
            font-size: 2.25rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.03em;
            margin-bottom: 0.5rem;
        }

        .dashboard-header p {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.6);
        }

        /* App Grid */
        .app-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* App Card */
        .app-card {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 220px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .app-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 0;
        }

        .app-card:hover {
            transform: translateY(-5px);
            border-color: rgba(102, 126, 234, 0.4);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3), 0 0 15px rgba(102, 126, 234, 0.1);
        }

        .app-card:hover::before {
            opacity: 1;
        }

        /* Pending App Specific Styling */
        .app-card.pending {
            border-color: rgba(102, 126, 234, 0.6);
            background: rgba(102, 126, 234, 0.06);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.15);
        }

        .app-card.pending::before {
            opacity: 0.3;
        }

        .app-card.pending:hover {
            border-color: #667eea;
            box-shadow: 0 12px 35px rgba(102, 126, 234, 0.3), 0 0 20px rgba(102, 126, 234, 0.2);
        }

        .badge-pending {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #ffffff;
            font-size: 0.6875rem;
            font-weight: 600;
            padding: 0.3rem 0.65rem;
            border-radius: 20px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            z-index: 10;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
                box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            }
            50% {
                transform: scale(1.03);
                box-shadow: 0 2px 14px rgba(102, 126, 234, 0.6);
            }
            100% {
                transform: scale(1);
                box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            }
        }

        .app-content {
            position: relative;
            z-index: 1;
        }

        .app-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
            color: #a3b8cc;
            transition: all 0.3s ease;
        }

        .app-card:hover .app-icon {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            transform: scale(1.05);
        }

        .app-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 0.35rem;
        }

        .app-client-id {
            font-size: 0.75rem;
            font-family: monospace;
            color: rgba(255, 255, 255, 0.4);
        }

        .app-actions {
            margin-top: 2rem;
            position: relative;
            z-index: 1;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 0.75rem;
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .action-btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #ffffff;
            border: none;
            box-shadow: 0 4px 14px rgba(102, 126, 234, 0.3);
        }

        .action-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
        }

        .action-btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .action-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
        }

        .action-btn:active {
            transform: translateY(0);
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px dashed rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 4rem;
        }

        .empty-state svg {
            width: 64px;
            height: 64px;
            fill: rgba(255, 255, 255, 0.2);
            margin-bottom: 1.5rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            font-weight: 500;
            color: #ffffff;
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            font-size: 0.875rem;
            color: rgba(255, 255, 255, 0.4);
        }

        /* Footer */
        .footer {
            text-align: center;
            padding: 2.5rem;
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.3);
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(0, 0, 0, 0.1);
        }

        /* Animations */
        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Dropdown & Modals Styling */
        .triple-dot-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #e0e0e0;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-left: 0.5rem;
        }

        .triple-dot-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            margin-top: 0.5rem;
            background: rgba(30, 27, 57, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            min-width: 160px;
            z-index: 1000;
            overflow: hidden;
            animation: dropdownFadeIn 0.2s ease;
        }

        .dropdown-menu.show {
            display: block;
        }

        .dropdown-item {
            display: block;
            width: 100%;
            padding: 0.75rem 1rem;
            background: transparent;
            border: none;
            color: #e0e0e0;
            text-align: left;
            font-size: 0.875rem;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .dropdown-item:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #ffffff;
        }

        @@keyframes dropdownFadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Modal Layout */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal-content {
            background: #1e1b39;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            width: 100%;
            max-width: 520px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
            overflow: hidden;
            animation: modalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes modalPop {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-header {
            padding: 1.5rem 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-header h2 {
            font-size: 1.15rem;
            font-weight: 600;
            color: #ffffff;
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            font-size: 1.5rem;
            color: rgba(255, 255, 255, 0.4);
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .modal-close-btn:hover {
            color: #ffffff;
        }

        .modal-body {
            padding: 2rem;
        }

        /* Notice Card */
        .security-notice-card {
            background: rgba(245, 158, 11, 0.06);
            border: 1.5px solid rgba(245, 158, 11, 0.4);
            border-radius: 12px;
            padding: 1.25rem;
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .notice-icon {
            color: #f59e0b;
            flex-shrink: 0;
            margin-top: 0.2rem;
        }

        .notice-content h3 {
            font-size: 0.9375rem;
            font-weight: 600;
            color: #f59e0b;
            margin-bottom: 0.35rem;
        }

        .notice-content p {
            font-size: 0.8125rem;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.5;
        }

        /* Checkbox */
        .checkbox-container {
            margin: 1.5rem 0;
        }

        .custom-checkbox {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            font-size: 0.875rem;
            color: rgba(255, 255, 255, 0.85);
            user-select: none;
        }

        .custom-checkbox input[type="checkbox"] {
            display: none;
        }

        .checkbox-mark {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 6px;
            display: inline-block;
            position: relative;
            transition: all 0.2s ease;
            background: rgba(255, 255, 255, 0.02);
        }

        .custom-checkbox input[type="checkbox"]:checked + .checkbox-mark {
            background: #10b981;
            border-color: #10b981;
        }

        .custom-checkbox input[type="checkbox"]:checked + .checkbox-mark::after {
            content: '';
            position: absolute;
            left: 6px;
            top: 2px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .enable-totp-submit-btn {
            width: 100%;
            padding: 0.875rem;
            background: #10b981;
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 0.9375rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
            text-align: center;
        }

        .enable-totp-submit-btn:hover {
            background: #059669;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
        }

        .enable-totp-submit-btn:active {
            transform: translateY(0);
        }

        .disclaimer-error-msg {
            display: none;
            color: #fca5a5;
            font-size: 0.8125rem;
            margin-top: 0.5rem;
            text-align: center;
            animation: shake 0.4s ease-in-out;
        }

        .modal-footer-desc {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.4);
            text-align: center;
            margin-top: 1.5rem;
            line-height: 1.5;
        }

        /* Setup Steps Layout */
        .setup-step-container {
            display: flex;
            gap: 1rem;
        }

        .step-badge {
            width: 24px;
            height: 24px;
            background: #10b981;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            flex-shrink: 0;
            margin-top: 0.2rem;
        }

        .step-content {
            flex-grow: 1;
        }

        .step-content h3 {
            font-size: 0.9375rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 0.25rem;
        }

        .step-content p {
            font-size: 0.8125rem;
            color: rgba(255, 255, 255, 0.5);
            line-height: 1.4;
        }

        .code-reveal-card {
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.02);
            border-radius: 12px;
            margin-top: 0.75rem;
            overflow: hidden;
            width: 100%;
        }

        .card-reveal-header {
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.6875rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.5);
            letter-spacing: 0.5px;
        }

        .reveal-btn {
            background: #6366f1;
            border: none;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
            font-size: 0.6875rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            transition: all 0.2s ease;
        }

        .reveal-btn:hover {
            background: #4f46e5;
        }

        .card-reveal-body {
            position: relative;
            min-height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .blur-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(30, 27, 57, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.7);
            padding: 1rem;
            z-index: 10;
        }

        .verify-btn {
            flex-grow: 1;
            padding: 0.75rem;
            background: #10b981;
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
            text-align: center;
        }

        .verify-btn:hover {
            background: #059669;
        }

        .cancel-btn {
            padding: 0.75rem 1.25rem;
            background: #4b5563;
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
        }

        .cancel-btn:hover {
            background: #374151;
        }

        .otp-digit-input.otp-box-dashboard {
            width: 40px;
            height: 44px;
            padding: 0;
            text-align: center;
            font-size: 1.15rem;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.06);
            color: white;
            outline: none;
        }

        .otp-digit-input.otp-box-dashboard:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }

        .important-notice-card {
            background: rgba(245, 158, 11, 0.03);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 12px;
            padding: 1rem;
            margin-top: 1.5rem;
        }

        .important-notice-card ul {
            padding-left: 1.25rem;
            margin: 0;
        }

        .important-notice-card li {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 0.35rem;
            line-height: 1.4;
        }

        .important-notice-card li:last-child {
            margin-bottom: 0;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        /* ---- Change Password Modal ---- */
        .chpw-field-group {
            margin-bottom: 1.25rem;
        }

        .chpw-field-group label {
            display: block;
            font-size: 0.8125rem;
            font-weight: 500;
            color: rgba(255,255,255,0.7);
            margin-bottom: 0.45rem;
        }

        .chpw-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .chpw-input {
            width: 100%;
            padding: 0.75rem 2.75rem 0.75rem 1rem;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            color: #e0e0e0;
            font-size: 0.9375rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .chpw-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
        }

        .chpw-eye-btn {
            position: absolute;
            right: 0.75rem;
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.4);
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            transition: color 0.2s;
        }

        .chpw-eye-btn:hover {
            color: rgba(255,255,255,0.8);
        }

        .chpw-submit-btn {
            width: 100%;
            padding: 0.9rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            color: #ffffff;
            font-size: 0.9375rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
            transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 14px rgba(102,126,234,0.35);
        }

        .chpw-submit-btn:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(102,126,234,0.5);
        }

        .chpw-submit-btn:active {
            transform: translateY(0);
        }

        .chpw-submit-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        .chpw-alert {
            display: none;
            border-radius: 8px;
            padding: 0.65rem 0.9rem;
            font-size: 0.8125rem;
            margin-top: 0.9rem;
            text-align: center;
        }

        .chpw-alert.success {
            display: block;
            background: rgba(16,185,129,0.12);
            border: 1px solid rgba(16,185,129,0.35);
            color: #6ee7b7;
        }

        .chpw-alert.error {
            display: block;
            background: rgba(239,68,68,0.1);
            border: 1px solid rgba(239,68,68,0.3);
            color: #fca5a5;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-brand">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                </svg>
            </div>
            <span class="brand-name">Auth Service IDP</span>
        </div>

        <div class="user-profile">
            <div class="user-details">
                <div class="user-name">@Model.UserName</div>
                <div class="user-email">@Model.UserEmail</div>
            </div>
            <a href="/connect/applogout" class="app-logout-btn">App Logout</a>
            <a href="/connect/logout" class="logout-btn">Sign Out</a>

            <!-- Settings Dropdown Container -->
            <div class="dropdown-container" style="position: relative; display: inline-block;">
                <button class="triple-dot-btn" onclick="toggleDropdown(event)" title="Account Settings">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="1.5"></circle>
                        <circle cx="12" cy="5" r="1.5"></circle>
                        <circle cx="12" cy="19" r="1.5"></circle>
                    </svg>
                </button>
                <div id="settingsDropdown" class="dropdown-menu">
                    <button class="dropdown-item" onclick="openTotpDisclaimerModal()">Enable TOTP</button>
                    <button class="dropdown-item" onclick="openChangePasswordModal()">Change Password</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container">
        <div class="dashboard-header">
            <h1>Welcome back, @Model.UserName</h1>
            <p>Select an application to securely log in and access your portal.</p>
        </div>

        <div class="app-grid">
            @if (Model.Applications != null && Model.Applications.Any())
            {
                @foreach (var app in Model.Applications)
                {
                    <div class="app-card @(app.IsPending ? "pending" : "")">
                        @if (app.IsPending)
                        {
                            <span class="badge-pending">Active Request</span>
                        }

                        <div class="app-content">
                            <div class="app-icon">
                                @if (app.ClientId.Contains("demo") || app.ClientId.Contains("api"))
                                {
                                    <!-- Code Icon -->
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="16 18 22 12 16 6"></polyline>
                                        <polyline points="8 6 2 12 8 18"></polyline>
                                    </svg>
                                }
                                else if (app.ClientId.Contains("cts"))
                                {
                                    <!-- Monitor Icon -->
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                        <line x1="8" y1="21" x2="16" y2="21"></line>
                                        <line x1="12" y1="17" x2="12" y2="21"></line>
                                    </svg>
                                }
                                else
                                {
                                    <!-- Default Grid Icon -->
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                }
                            </div>
                            <h2 class="app-title">@app.DisplayName</h2>
                            <span class="app-client-id">ClientID: @app.ClientId</span>
                        </div>

                        <div class="app-actions">
                            @if (!string.IsNullOrEmpty(app.TargetUrl))
                            {
                                @if (app.IsPending)
                                {
                                    <a href="@app.TargetUrl" class="action-btn action-btn-primary">Resume Login</a>
                                }
                                else
                                {
                                    <a href="@app.TargetUrl" class="action-btn action-btn-secondary">Launch Application</a>
                                }
                            }
                            else
                            {
                                <button class="action-btn action-btn-secondary" style="opacity: 0.5; cursor: not-allowed;" disabled>Configuration Missing</button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2z"/>
                    </svg>
                    <h3>No Applications Available</h3>
                    <p>There are no interactive client applications registered in the database.</p>
                </div>
            }
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p>Single Sign-On Identity Provider &bull; Powered by OpenIddict</p>
    </footer>

    <!-- Modal 1: Security Disclaimer Notice -->
    <div id="totpDisclaimerModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Enable Two-Factor Authentication by TOTP</h2>
                <button class="modal-close-btn" onclick="closeTotpDisclaimerModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="security-notice-card">
                    <div class="notice-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <div class="notice-content">
                        <h3>Important Security Notice</h3>
                        <p>Please do not share or show the QR code and secret key to anyone. You are fully responsible for keeping this information secure. Anyone with access to this secret can log in to your account.</p>
                    </div>
                </div>
                
                <div class="checkbox-container">
                    <label class="custom-checkbox">
                        <input type="checkbox" id="acceptDisclaimerCheckbox" onchange="hideDisclaimerError()" />
                        <span class="checkbox-mark"></span>
                        I understand and accept this responsibility
                    </label>
                </div>

                <button class="enable-totp-submit-btn" onclick="handleDisclaimerSubmit()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; display: inline-block; vertical-align: middle;">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span style="vertical-align: middle;">Enable TOTP</span>
                </button>

                <div id="disclaimerError" class="disclaimer-error-msg">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; display: inline-block; vertical-align: middle;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span style="vertical-align: middle;">Please check the disclaimer above to proceed</span>
                </div>

                <p class="modal-footer-desc">
                    Enhance your account security by enabling Two-Factor Authentication using authenticator apps (Google Authenticator, Microsoft Authenticator, Authy, etc.)
                </p>
            </div>
        </div>
    </div>

    <!-- Modal 2: Step-by-Step TOTP Setup -->
    <div id="totpSetupModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 460px; max-height: 90vh; display: flex; flex-direction: column;">
            <div class="modal-header">
                <h2>Enable Two-Factor Authentication by TOTP</h2>
                <button class="modal-close-btn" onclick="closeTotpSetupModal()">&times;</button>
            </div>
            <div class="modal-body" style="overflow-y: auto; flex-grow: 1; padding: 1.5rem;">
                
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; border-bottom: 1.5px solid rgba(255, 255, 255, 0.06); padding-bottom: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="color: #10b981; display: inline-flex; align-items: center;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 16v-4"></path>
                                <path d="M12 8h.01"></path>
                            </svg>
                        </span>
                        <span style="font-size: 0.9375rem; font-weight: 600; color: #ffffff;">Set Up Two-Factor Authentication by TOTP</span>
                    </div>
                </div>

                <!-- Step 1: Scan QR Code -->
                <div class="setup-step-container">
                    <div class="step-badge">1</div>
                    <div class="step-content">
                        <h3>Scan QR Code</h3>
                        <p>Use an authenticator app to scan this QR code.</p>
                        
                        <div class="code-reveal-card" id="qrRevealCard">
                            <div class="card-reveal-header">
                                <span>QR CODE (CLICK TO SHOW)</span>
                                <button class="reveal-btn" onclick="toggleReveal('qr')">
                                    <svg id="qrEyeIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: middle;">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <span id="qrBtnText" style="vertical-align: middle;">SHOW</span>
                                </button>
                            </div>
                            <div class="card-reveal-body">
                                <div class="blur-overlay" id="qrBlurOverlay">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 8px;">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                    <div>QR Code is Hidden - Click 'Show' above to view it</div>
                                    <div style="font-size: 0.6875rem; opacity: 0.5; margin-top: 4px;">secret for 1 account only</div>
                                </div>
                                <img id="setupQrImage" src="" alt="TOTP QR Code" style="display: none; width: 140px; height: 140px; margin: 0 auto;" />
                            </div>
                        </div>

                        <h4 style="font-size: 0.8125rem; font-weight: 500; color: rgba(255, 255, 255, 0.4); margin: 1.25rem 0 0.5rem 0; text-transform: uppercase; letter-spacing: 0.5px;">Can't scan? Enter this code manually:</h4>
                        
                        <div class="code-reveal-card" id="secretRevealCard">
                            <div class="card-reveal-header">
                                <span>SECRET KEY (CLICK TO SHOW)</span>
                                <button class="reveal-btn" onclick="toggleReveal('secret')">
                                    <svg id="secretEyeIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: middle;">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <span id="secretBtnText" style="vertical-align: middle;">SHOW</span>
                                </button>
                            </div>
                            <div class="card-reveal-body" style="padding: 1rem 0; min-height: 80px;">
                                <div class="blur-overlay" id="secretBlurOverlay">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 8px;">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                    <div>Secret is Hidden - Click 'Show' above to view it</div>
                                    <div style="font-size: 0.6875rem; opacity: 0.5; margin-top: 4px;">secret for 1 account only</div>
                                </div>
                                <div id="setupSecretText" style="display: none; font-family: monospace; font-size: 1.125rem; font-weight: 700; color: #a3b8cc; text-align: center; letter-spacing: 1.5px; user-select: all; width: 100%;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Verify Setup -->
                <div class="setup-step-container" style="margin-top: 1.5rem;">
                    <div class="step-badge">2</div>
                    <div class="step-content" style="width: 100%;">
                        <h3>Verify Setup</h3>
                        <p>Enter the 6-digit code from your authenticator app in orders.</p>
                        
                        <div style="margin-top: 1rem;">
                           <label style="display: block; font-size: 0.8125rem; font-weight: 500; color: rgba(255, 255, 255, 0.6); margin-bottom: 0.5rem;">Enter 6-digit code</label>
                           <div class="otp-inputs" style="display: flex; gap: 8px; justify-content: center; margin: 10px 0;">
                               <input type="text" class="otp-digit-input otp-box-dashboard" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                               <input type="text" class="otp-digit-input otp-box-dashboard" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                               <input type="text" class="otp-digit-input otp-box-dashboard" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                               <input type="text" class="otp-digit-input otp-box-dashboard" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                               <input type="text" class="otp-digit-input otp-box-dashboard" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                               <input type="text" class="otp-digit-input otp-box-dashboard" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                           </div>
                       </div>

                       <!-- Buttons -->
                       <div style="display: flex; gap: 10px; margin-top: 1.5rem;">
                           <button class="verify-btn" onclick="handleVerifyDashboardTotp()">
                               <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
                                   <polyline points="20 6 9 17 4 12"></polyline>
                               </svg>
                               <span style="vertical-align: middle;">Verify & Enable TOTP</span>
                           </button>
                           <button class="cancel-btn" onclick="closeTotpSetupModal()">
                               <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
                                   <line x1="18" y1="6" x2="6" y2="18"></line>
                                   <line x1="6" y1="6" x2="18" y2="18"></line>
                               </svg>
                               <span style="vertical-align: middle;">Cancel</span>
                           </button>
                       </div>
                       
                       <div id="totpSetupVerifyError" class="disclaimer-error-msg" style="margin-top: 0.75rem;"></div>
                    </div>
                </div>

                <div class="important-notice-card">
                   <div style="display: flex; align-items: flex-start; gap: 8px; color: #f59e0b; margin-bottom: 0.5rem;">
                       <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-top: 2px;">
                           <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                           <line x1="12" y1="9" x2="12" y2="13"></line>
                           <line x1="12" y1="17" x2="12.01" y2="17"></line>
                       </svg>
                       <span style="font-size: 0.8125rem; font-weight: 600;">Important</span>
                   </div>
                   <ul>
                       <li>Save your secret key in a secure place as a backup.</li>
                       <li>Once enabled, you'll need your authenticator app to log in.</li>
                       <li>Codes expire every 30 seconds, so enter it quickly.</li>
                       <li>If you lose access to your app, contact support.</li>
                   </ul>
                </div>

            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div id="changePasswordModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 460px;">
            <div class="modal-header">
                <h2>Change Password</h2>
                <button class="modal-close-btn" onclick="closeChangePasswordModal()">&times;</button>
            </div>
            <div class="modal-body">

                <!-- Current Password -->
                <div class="chpw-field-group">
                    <label for="chpwCurrent">Current Password</label>
                    <div class="chpw-input-wrap">
                        <input id="chpwCurrent" type="password" class="chpw-input" placeholder="" autocomplete="current-password" />
                        <button type="button" class="chpw-eye-btn" onclick="toggleChpwVisibility('chpwCurrent', 'eyeIconCurrent')" tabindex="-1">
                            <svg id="eyeIconCurrent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- New Password -->
                <div class="chpw-field-group">
                    <label for="chpwNew">New Password</label>
                    <div class="chpw-input-wrap">
                        <input id="chpwNew" type="password" class="chpw-input" placeholder="" autocomplete="new-password" />
                        <button type="button" class="chpw-eye-btn" onclick="toggleChpwVisibility('chpwNew', 'eyeIconNew')" tabindex="-1">
                            <svg id="eyeIconNew" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="chpw-field-group">
                    <label for="chpwConfirm">Confirm Password</label>
                    <div class="chpw-input-wrap">
                        <input id="chpwConfirm" type="password" class="chpw-input" placeholder="" autocomplete="new-password" />
                    </div>
                </div>

                <!-- Submit -->
                <button id="chpwSubmitBtn" class="chpw-submit-btn" onclick="handleChangePassword()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Change Password
                </button>

                <div id="chpwAlert" class="chpw-alert"></div>
            </div>
        </div>
    </div>

    <script>
        // --- Settings Dropdown Toggle ---
        function toggleDropdown(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('settingsDropdown');
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        window.addEventListener('click', function(event) {
            const dropdown = document.getElementById('settingsDropdown');
            if (dropdown && dropdown.classList.contains('show')) {
                dropdown.classList.remove('show');
            }
        });

        // --- Disclaimer Modal Handlers ---
        function openTotpDisclaimerModal() {
            document.getElementById('acceptDisclaimerCheckbox').checked = false;
            hideDisclaimerError();
            document.getElementById('totpDisclaimerModal').classList.add('show');
        }

        function closeTotpDisclaimerModal() {
            document.getElementById('totpDisclaimerModal').classList.remove('show');
        }

        function hideDisclaimerError() {
            document.getElementById('disclaimerError').style.display = 'none';
        }

        async function handleDisclaimerSubmit() {
            const checkbox = document.getElementById('acceptDisclaimerCheckbox');
            const errorMsg = document.getElementById('disclaimerError');
            
            if (!checkbox.checked) {
                errorMsg.style.display = 'block';
                return;
            }

            closeTotpDisclaimerModal();
            openTotpSetupModal();
        }

        // --- Setup Modal Handlers ---
        function openTotpSetupModal() {
            resetReveal('qr');
            resetReveal('secret');
            document.getElementById('totpSetupVerifyError').style.display = 'none';
            document.querySelectorAll('.otp-box-dashboard').forEach(inp => inp.value = '');
            
            const setupModal = document.getElementById('totpSetupModal');
            setupModal.classList.add('show');

            fetchTotpSetupDetails();
        }

        function closeTotpSetupModal() {
            document.getElementById('totpSetupModal').classList.remove('show');
        }

        async function fetchTotpSetupDetails() {
            try {
                const response = await fetch('/Account/GetTotpSetupDetailsApi');
                if (response.ok) {
                    const data = await response.json();
                    
                    document.getElementById('setupQrImage').src = 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=' + encodeURIComponent(data.qrCodeUrl);
                    document.getElementById('setupSecretText').textContent = data.secret;
                } else {
                    const data = await response.json().catch(() => ({}));
                    alert(data.error || 'Failed to load TOTP setup configuration.');
                    closeTotpSetupModal();
                }
            } catch (err) {
                alert('Connection error. Please try again.');
                closeTotpSetupModal();
            }
        }

        // --- Reveal Blurs Controls ---
        function toggleReveal(type) {
            const isQr = type === 'qr';
            const blurOverlay = document.getElementById(isQr ? 'qrBlurOverlay' : 'secretBlurOverlay');
            const targetElement = document.getElementById(isQr ? 'setupQrImage' : 'setupSecretText');
            const btnText = document.getElementById(isQr ? 'qrBtnText' : 'secretBtnText');
            const eyeIcon = document.getElementById(isQr ? 'qrEyeIcon' : 'secretEyeIcon');

            if (blurOverlay.style.display !== 'none') {
                blurOverlay.style.display = 'none';
                targetElement.style.display = isQr ? 'block' : 'inline-block';
                btnText.textContent = 'HIDE';
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                resetReveal(type);
            }
        }

        function resetReveal(type) {
            const isQr = type === 'qr';
            const blurOverlay = document.getElementById(isQr ? 'qrBlurOverlay' : 'secretBlurOverlay');
            const targetElement = document.getElementById(isQr ? 'setupQrImage' : 'setupSecretText');
            const btnText = document.getElementById(isQr ? 'qrBtnText' : 'secretBtnText');
            const eyeIcon = document.getElementById(isQr ? 'qrEyeIcon' : 'secretEyeIcon');

            blurOverlay.style.display = 'flex';
            targetElement.style.display = 'none';
            btnText.textContent = 'SHOW';
            eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
        }

        // --- OTP Input Box Management ---
        function setupDashboardOtpInputs() {
            const inputs = document.querySelectorAll('.otp-box-dashboard');
            inputs.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    if (e.target.value && !/^[0-9]$/.test(e.target.value)) {
                        e.target.value = '';
                        return;
                    }
                    if (e.target.value && index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }
                    
                    const code = Array.from(inputs).map(inp => inp.value).join('');
                    // Auto-submit disabled; user must click Verify button
                });

                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace') {
                        if (!e.target.value && index > 0) {
                            inputs[index - 1].focus();
                            inputs[index - 1].value = '';
                        } else {
                            e.target.value = '';
                        }
                        e.preventDefault();
                    }
                });

                input.addEventListener('paste', (e) => {
                    const data = (e.clipboardData || window.clipboardData).getData('text');
                    if (/^[0-9]{6}$/.test(data)) {
                        inputs.forEach((inp, idx) => {
                            inp.value = data[idx];
                        });
                        inputs[inputs.length - 1].focus();
                        // Auto-submit disabled after paste
                    }
                    e.preventDefault();
                });
            });
        }

        async function handleVerifyDashboardTotp(code) {
            if (!code) {
                code = Array.from(document.querySelectorAll('.otp-box-dashboard')).map(inp => inp.value).join('');
            }
            if (code.length !== 6) {
                return;
            }

            const errorEl = document.getElementById('totpSetupVerifyError');
            errorEl.style.display = 'none';

            try {
                const response = await fetch('/Account/VerifyTotpSetupApi', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: code }),
                    credentials: 'include'
                });

                if (response.ok) {
                    const data = await response.json();
                    window.location.reload();
                } else {
                    const data = await response.json().catch(() => ({}));
                    errorEl.textContent = data.error || 'Invalid verification code. Please try again.';
                    errorEl.style.display = 'block';
                    document.querySelectorAll('.otp-box-dashboard').forEach(inp => inp.value = '');
                    document.querySelectorAll('.otp-box-dashboard')[0].focus();
                }
            } catch (err) {
                errorEl.textContent = 'Connection error. Please try again.';
                errorEl.style.display = 'block';
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            setupDashboardOtpInputs();
        });

        // ---- Change Password Modal ----
        function openChangePasswordModal() {
            document.getElementById('chpwCurrent').value = '';
            document.getElementById('chpwNew').value = '';
            document.getElementById('chpwConfirm').value = '';
            const alert = document.getElementById('chpwAlert');
            alert.className = 'chpw-alert';
            alert.textContent = '';
            // Reset eye icons to closed
            ['chpwCurrent', 'chpwNew'].forEach(id => {
                document.getElementById(id).type = 'password';
            });
            document.getElementById('chpwConfirm').type = 'password';
            document.getElementById('changePasswordModal').classList.add('show');
        }

        function closeChangePasswordModal() {
            document.getElementById('changePasswordModal').classList.remove('show');
        }

        function toggleChpwVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }

        async function handleChangePassword() {
            const currentPw = document.getElementById('chpwCurrent').value;
            const newPw     = document.getElementById('chpwNew').value;
            const confirmPw = document.getElementById('chpwConfirm').value;
            const alertEl   = document.getElementById('chpwAlert');
            const submitBtn = document.getElementById('chpwSubmitBtn');

            // Reset alert
            alertEl.className = 'chpw-alert';
            alertEl.textContent = '';

            // Client-side validation
            if (!currentPw) {
                alertEl.className = 'chpw-alert error';
                alertEl.textContent = 'Please enter your current password.';
                return;
            }
            if (!newPw || newPw.length < 6) {
                alertEl.className = 'chpw-alert error';
                alertEl.textContent = 'New password must be at least 6 characters.';
                return;
            }
            if (newPw !== confirmPw) {
                alertEl.className = 'chpw-alert error';
                alertEl.textContent = 'New password and confirm password do not match.';
                return;
            }
            if (newPw === currentPw) {
                alertEl.className = 'chpw-alert error';
                alertEl.textContent = 'New password must be different from the current password.';
                return;
            }

            submitBtn.disabled = true;

            try {
                const response = await fetch('/Account/ChangePasswordApi', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword: currentPw, newPassword: newPw }),
                    credentials: 'include'
                });

                const data = await response.json().catch(() => ({}));

                if (response.ok) {
                    alertEl.className = 'chpw-alert success';
                    alertEl.textContent = data.message || 'Password changed successfully!';
                    // Clear fields
                    document.getElementById('chpwCurrent').value = '';
                    document.getElementById('chpwNew').value = '';
                    document.getElementById('chpwConfirm').value = '';
                } else {
                    alertEl.className = 'chpw-alert error';
                    alertEl.textContent = data.error || 'Failed to change password. Please try again.';
                }
            } catch (err) {
                alertEl.className = 'chpw-alert error';
                alertEl.textContent = 'Connection error. Please try again.';
            } finally {
                submitBtn.disabled = false;
            }
        }
    </script>
</body>
</html>
