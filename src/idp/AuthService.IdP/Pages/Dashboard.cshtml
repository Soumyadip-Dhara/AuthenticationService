@page
@model AuthService.IdP.Pages.DashboardModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Dashboard — Auth Service</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            color: #e0e0e0;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding: 1rem 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

        .brand-logo svg {
            width: 18px;
            height: 18px;
            fill: white;
        }

        .brand-name {
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.02em;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-details {
            text-align: right;
        }

        .user-name {
            font-size: 0.875rem;
            font-weight: 600;
            color: #ffffff;
        }

        .user-email {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.5);
        }

        .logout-btn {
            padding: 0.5rem 1rem;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 8px;
            color: #fca5a5;
            font-size: 0.8125rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.4);
            color: #ef4444;
            transform: translateY(-1px);
        }

        .app-logout-btn {
            padding: 0.5rem 1rem;
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 8px;
            color: #93c5fd;
            font-size: 0.8125rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
            margin-right: 0.5rem;
        }

        .app-logout-btn:hover {
            background: rgba(59, 130, 246, 0.2);
            border-color: rgba(59, 130, 246, 0.4);
            color: #3b82f6;
            transform: translateY(-1px);
        }

        /* Main Container */
        .container {
            max-width: 1000px;
            margin: 3.5rem auto;
            padding: 0 2rem;
            flex-grow: 1;
            width: 100%;
        }

        .dashboard-header {
            margin-bottom: 2.5rem;
            animation: fadeInDown 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .dashboard-header h1 {
            font-size: 2.25rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.03em;
            margin-bottom: 0.5rem;
        }

        .dashboard-header p {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.6);
        }

        /* App Grid */
        .app-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* App Card */
        .app-card {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 220px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .app-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 0;
        }

        .app-card:hover {
            transform: translateY(-5px);
            border-color: rgba(102, 126, 234, 0.4);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3), 0 0 15px rgba(102, 126, 234, 0.1);
        }

        .app-card:hover::before {
            opacity: 1;
        }

        /* Pending App Specific Styling */
        .app-card.pending {
            border-color: rgba(102, 126, 234, 0.6);
            background: rgba(102, 126, 234, 0.06);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.15);
        }

        .app-card.pending::before {
            opacity: 0.3;
        }

        .app-card.pending:hover {
            border-color: #667eea;
            box-shadow: 0 12px 35px rgba(102, 126, 234, 0.3), 0 0 20px rgba(102, 126, 234, 0.2);
        }

        .badge-pending {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #ffffff;
            font-size: 0.6875rem;
            font-weight: 600;
            padding: 0.3rem 0.65rem;
            border-radius: 20px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            z-index: 10;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
                box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            }
            50% {
                transform: scale(1.03);
                box-shadow: 0 2px 14px rgba(102, 126, 234, 0.6);
            }
            100% {
                transform: scale(1);
                box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
            }
        }

        .app-content {
            position: relative;
            z-index: 1;
        }

        .app-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
            color: #a3b8cc;
            transition: all 0.3s ease;
        }

        .app-card:hover .app-icon {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            transform: scale(1.05);
        }

        .app-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 0.35rem;
        }

        .app-client-id {
            font-size: 0.75rem;
            font-family: monospace;
            color: rgba(255, 255, 255, 0.4);
        }

        .app-actions {
            margin-top: 2rem;
            position: relative;
            z-index: 1;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 0.75rem;
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .action-btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #ffffff;
            border: none;
            box-shadow: 0 4px 14px rgba(102, 126, 234, 0.3);
        }

        .action-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
        }

        .action-btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .action-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
        }

        .action-btn:active {
            transform: translateY(0);
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px dashed rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 4rem;
        }

        .empty-state svg {
            width: 64px;
            height: 64px;
            fill: rgba(255, 255, 255, 0.2);
            margin-bottom: 1.5rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            font-weight: 500;
            color: #ffffff;
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            font-size: 0.875rem;
            color: rgba(255, 255, 255, 0.4);
        }

        /* Footer */
        .footer {
            text-align: center;
            padding: 2.5rem;
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.3);
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(0, 0, 0, 0.1);
        }

        /* Animations */
        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-brand">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                </svg>
            </div>
            <span class="brand-name">Auth Service IDP</span>
        </div>

        <div class="user-profile">
            <div class="user-details">
                <div class="user-name">@Model.UserName</div>
                <div class="user-email">@Model.UserEmail</div>
            </div>
            <a href="/connect/applogout" class="app-logout-btn">App Logout</a>
            <a href="/connect/logout" class="logout-btn">Sign Out</a>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container">
        <div class="dashboard-header">
            <h1>Welcome back, @Model.UserName</h1>
            <p>Select an application to securely log in and access your portal.</p>
        </div>

        <div class="app-grid">
            @if (Model.Applications != null && Model.Applications.Any())
            {
                @foreach (var app in Model.Applications)
                {
                    <div class="app-card @(app.IsPending ? "pending" : "")">
                        @if (app.IsPending)
                        {
                            <span class="badge-pending">Active Request</span>
                        }

                        <div class="app-content">
                            <div class="app-icon">
                                @if (app.ClientId.Contains("demo") || app.ClientId.Contains("api"))
                                {
                                    <!-- Code Icon -->
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="16 18 22 12 16 6"></polyline>
                                        <polyline points="8 6 2 12 8 18"></polyline>
                                    </svg>
                                }
                                else if (app.ClientId.Contains("cts"))
                                {
                                    <!-- Monitor Icon -->
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                        <line x1="8" y1="21" x2="16" y2="21"></line>
                                        <line x1="12" y1="17" x2="12" y2="21"></line>
                                    </svg>
                                }
                                else
                                {
                                    <!-- Default Grid Icon -->
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                }
                            </div>
                            <h2 class="app-title">@app.DisplayName</h2>
                            <span class="app-client-id">ClientID: @app.ClientId</span>
                        </div>

                        <div class="app-actions">
                            @if (!string.IsNullOrEmpty(app.TargetUrl))
                            {
                                @if (app.IsPending)
                                {
                                    <a href="@app.TargetUrl" class="action-btn action-btn-primary">Resume Login</a>
                                }
                                else
                                {
                                    <a href="@app.TargetUrl" class="action-btn action-btn-secondary">Launch Application</a>
                                }
                            }
                            else
                            {
                                <button class="action-btn action-btn-secondary" style="opacity: 0.5; cursor: not-allowed;" disabled>Configuration Missing</button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2z"/>
                    </svg>
                    <h3>No Applications Available</h3>
                    <p>There are no interactive client applications registered in the database.</p>
                </div>
            }
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p>Single Sign-On Identity Provider &bull; Powered by OpenIddict</p>
    </footer>
</body>
</html>
