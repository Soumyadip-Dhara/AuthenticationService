{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "https://10.176.100.17:5001",
    "ClientId": "demo-login-bff",
    "ClientSecret": "demo-login-bff-secret",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "api:demo",
      "offline_access"
    ],
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Session": {
    "CookieName": ".demo.session"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "demo-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "demo-api": {
        "Destinations": {
          "primary": {
            "_comment": "Demo API",
            "Address": "https://localhost:6004"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "_comment": "Demo API � Kestrel HTTPS endpoint",
        "Url": "https://*:5004"
      }
    }
  }
}