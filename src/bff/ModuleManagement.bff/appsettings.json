{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "https://10.176.100.17:5001",
    "ClientId": "modulemanagement-bff",
    "ClientSecret": "modulemanagement-bff-secret",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "api:modulemanagement",
      "offline_access"
    ],
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Session": {
    "CookieName": ".modulemanagement.session"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "modulemanagement-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "modulemanagement-api": {
        "Destinations": {
          "primary": {
            "Address": "https://10.176.100.10:6006"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:7092"
      }
    }
  },
  "FrontendUrl": "https://10.176.100.90:4500"
}
