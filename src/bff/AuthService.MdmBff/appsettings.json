{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "https://10.176.100.17:5001",
    "ClientId": "mdm-bff",
    "ClientSecret": "mdm-bff-secret",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "api:mdm",
      "offline_access"
    ],
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Session": {
    "CookieName": ".mdm.session"
  },
  "FrontendUrl": "https://localhost:4200",
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "mdm-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "mdm-api": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5274"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5005"
      }
    }
  }
}
